---
import { getLocale, useTranslations } from "@/i18n";

const t = useTranslations(getLocale(Astro.url.pathname));
---

<section id="about" class="mt-16 scroll-mt-8 md:mt-0">
  <h2 class="text-4xl lg:text-5xl font-bold lg:tracking-tight">{t.about.title}</h2>
  <div class="mt-4 max-w-3xl space-y-4 text-lg leading-relaxed text-slate-600">
    {t.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
  </div>
</section>
