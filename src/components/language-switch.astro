---
import { getLocale, localePath } from "@/i18n";

const locale = getLocale(Astro.url.pathname);
const enHref = localePath("en", Astro.url.pathname);
const zhHref = localePath("zh", Astro.url.pathname);
const label = locale === "zh" ? "语言" : "Language";

const linkClass = "rounded-full px-2.5 py-1.5 transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-black";
---

<div
  role="group"
  aria-label={label}
  class="inline-flex items-center rounded-full border border-gray-200 bg-white p-0.5 text-sm leading-none font-medium">
  <a
    href={enHref}
    hreflang="en"
    lang="en"
    data-locale-switch
    aria-label="English"
    aria-current={locale === "en" ? "true" : undefined}
    class:list={[linkClass, locale === "en" ? "bg-black text-white" : "text-gray-500 hover:text-black"]}>
    EN
  </a>
  <a
    href={zhHref}
    hreflang="zh-CN"
    lang="zh-CN"
    data-locale-switch
    aria-label="中文"
    aria-current={locale === "zh" ? "true" : undefined}
    class:list={[linkClass, locale === "zh" ? "bg-black text-white" : "text-gray-500 hover:text-black"]}>
    中文
  </a>
</div>

<script>
  function keepSectionHash() {
    const hash = window.location.hash;
    document.querySelectorAll<HTMLAnchorElement>("a[data-locale-switch]").forEach((link) => {
      const url = new URL(link.href, window.location.href);
      url.hash = hash;
      link.href = `${url.pathname}${url.search}${url.hash}`;
    });
  }

  keepSectionHash();
  window.addEventListener("hashchange", keepSectionHash);
</script>
