---
import poster from "@/assets/lob-poster.webp";
import heroVideo from "@/assets/lob.mp4";
---

<main class="flex flex-col pt-16 pb-8 md:pt-12 md:pb-24">
  <div class="text-center">
    <h1
      class="text-5xl lg:text-6xl xl:text-7xl font-bold lg:tracking-tight xl:tracking-tighter">
      Speak on your iPhone. Talk to any AI app on your Mac.
    </h1>
    <p class="text-lg mt-4 text-slate-600 max-w-xl mx-auto">
      Use the voice input already on your iPhone. Lob types what you say into
      the AI app open on your Mac, right where the cursor is.
    </p>
  </div>
  <div class="mt-10 md:mt-14 overflow-hidden">
    <!-- The right edge of a scaled video flashes a 1px line. Bleed 4px past the clip. -->
    <video
      class="hero-video block h-auto w-[calc(100%+4px)] max-w-none -mr-1 bg-white"
      width={poster.width}
      height={poster.height}
      poster={poster.src}
      muted
      loop
      playsinline
      preload="metadata"
      disableremoteplayback
      aria-label="Speaking on an iPhone to an AI app on a Mac">
      <source src={heroVideo} type="video/mp4" />
    </video>
  </div>
</main>

<script>
  const video = document.querySelector<HTMLVideoElement>(".hero-video");
  if (video) {
    const motion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const sync = () => {
      if (motion.matches) {
        video.pause();
        video.currentTime = 0;
        return;
      }
      video.muted = true;
      void video.play().catch(() => {});
    };
    sync();
    motion.addEventListener("change", sync);
  }
</script>
