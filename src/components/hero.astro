---
import poster from "@/assets/lob-poster.webp";
import heroVideo from "@/assets/lob.mp4";
import heroVideoMobile from "@/assets/lob-1280.mp4";
import { getLocale, useTranslations } from "@/i18n";

const locale = getLocale(Astro.url.pathname);
const t = useTranslations(locale);
---

<main class="flex flex-col pt-16 pb-8 md:pt-12 md:pb-24">
  <div class="text-center">
    <h1
      class:list={[
        "mx-auto max-w-5xl font-bold text-balance",
        locale === "zh"
          ? "text-4xl leading-tight sm:text-5xl lg:text-6xl"
          : "text-5xl lg:text-6xl xl:text-7xl lg:tracking-tight xl:tracking-tighter",
      ]}>
      {
        t.hero.lines.map((line, index) => (
          <>
            {index > 0 && <br class="sm:hidden" />}
            {line}
          </>
        ))
      }
    </h1>
    <p class="text-lg mt-4 text-slate-600 max-w-xl mx-auto">{t.hero.body}</p>
  </div>
  <div class="mt-10 md:mt-14 bg-white">
    <video
      class="hero-video block h-auto w-full bg-white object-cover"
      src={heroVideo}
      data-src={heroVideo}
      data-src-mobile={heroVideoMobile}
      width={poster.width}
      height={poster.height}
      poster={poster.src}
      muted
      loop
      playsinline
      preload="none"
      disablepictureinpicture
      disableremoteplayback
      aria-label={t.hero.videoLabel}>
    </video>
  </div>
</main>

<script>
  const video = document.querySelector<HTMLVideoElement>(".hero-video");
  if (video) {
    const motion = window.matchMedia("(prefers-reduced-motion: reduce)");

    // Pick the source ourselves instead of relying on <source media>:
    // Safari does not always honour the media attribute and would send the
    // full-size clip to phones (or the phone clip to the desktop).
    const smallScreen = window.matchMedia("(max-width: 767px)");
    const desktopSrc = video.dataset.src ?? "";
    const mobileSrc = video.dataset.srcMobile ?? "";
    const pickSource = () =>
      (smallScreen.matches ? mobileSrc || desktopSrc : desktopSrc) || desktopSrc;

    let source = video.getAttribute("src") || desktopSrc;
    let onScreen = true;
    let autoplayBlocked = false;
    let fallbackTried = false;

    // Keep the video on whole-pixel dimensions. Safari composites video in its
    // own layer, and a fractional height can expose the layer's black edge
    // while the page is scrolling.
    const frame = video.parentElement;
    let fittedWidth = 0;
    const fitVideo = () => {
      if (!frame) return;
      const width = frame.clientWidth;
      if (!width || width === fittedWidth) return;
      fittedWidth = width;
      const attrWidth = Number(video.getAttribute("width")) || 2560;
      const attrHeight = Number(video.getAttribute("height")) || 1560;
      const ratio = attrHeight / attrWidth;
      video.style.width = `${width}px`;
      video.style.height = `${Math.round(width * ratio)}px`;
    };
    fitVideo();
    if (frame && "ResizeObserver" in window) {
      new ResizeObserver(fitVideo).observe(frame);
    }
    window.addEventListener("resize", fitVideo);

    const startPlayback = () => {
      video.muted = true;
      const attempt = video.play();
      if (attempt && typeof attempt.catch === "function") {
        void attempt.catch(() => {
          // Autoplay is refused (iOS Low Power Mode, strict browser settings).
          // The poster stays up until the visitor interacts with the page.
          autoplayBlocked = true;
        });
      }
    };

    const sync = () => {
      if (motion.matches || document.hidden || !onScreen) {
        video.pause();
        if (motion.matches) video.currentTime = 0;
        return;
      }
      startPlayback();
    };

    const setSource = (next: string, retrying = false) => {
      if (!next || next === source) return;
      if (!retrying) fallbackTried = false;
      source = next;
      video.src = next;
      video.load();
      sync();
    };

    // The mobile clip is optional: fall back to the full-size file if it is
    // missing, and vice versa if the desktop file cannot be played. Do not
    // bounce between the two when both are broken.
    video.addEventListener("error", () => {
      if (fallbackTried) return;
      const fallback = source === mobileSrc ? desktopSrc : mobileSrc;
      if (!fallback || fallback === source) return;
      fallbackTried = true;
      setSource(fallback, true);
    });

    // Only play while the hero is on screen; pause when it scrolls away
    // or when the tab is in the background.
    new IntersectionObserver(
      ([entry]) => {
        onScreen = entry.isIntersecting;
        sync();
      },
      { threshold: 0.2 },
    ).observe(video);

    motion.addEventListener("change", sync);
    document.addEventListener("visibilitychange", sync);
    smallScreen.addEventListener("change", () => setSource(pickSource()));

    // A first user interaction is enough for most browsers to allow muted
    // playback after they refused it on load.
    const retryPlayback = () => {
      if (!autoplayBlocked || motion.matches || document.hidden || !onScreen) return;
      autoplayBlocked = false;
      startPlayback();
    };
    window.addEventListener("pointerdown", retryPlayback, { passive: true });
    window.addEventListener("keydown", retryPlayback);

    const preferred = pickSource();
    if (preferred && preferred !== source) {
      setSource(preferred);
    } else {
      sync();
    }
  }
</script>

<style>
  .hero-video {
    /* Keep Safari from re-positioning the video layer while the page scrolls.
       The white border hides the layer's edge if it slips by a pixel. */
    border: 1px solid #fff;
    transform: translateZ(0);
    backface-visibility: hidden;
  }
</style>
