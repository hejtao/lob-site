---
// @ts-ignore
import { Icon } from "astro-icon/components";

const features = [
  {
    title: "Your iPhone is the microphone",
    description:
      "Use the iPhone you already have as the microphone. You do not need to buy another microphone for your Mac.",
    icon: "bx:bxs-microphone",
  },
  {
    title: "Reuse voice input tool you already have",
    description:
      "Dictate with the voice tools already on your iPhone, including the built-in one. Lob sends that text to your Mac, so you do not need a new voice input tool.",
    icon: "bx:bxs-user-voice",
  },
  {
    title: "Typed at the Mac cursor",
    description:
      "Lob types the text into whichever field is focused on your Mac, the same way a keyboard would.",
    icon: "bx:bxs-keyboard",
  },
  {
    title: "No copy, AirDrop, or Notes",
    description:
      "Skip the extra step. The words go from the phone straight into the Mac field, with nothing to copy or paste.",
    icon: "bx:bxs-paste",
  },
  {
    title: "Connected over Bluetooth",
    description:
      "After the apps are installed, the iPhone and Mac talk over Bluetooth. Unplug the cable and keep sending.",
    icon: "bx:bluetooth",
  },
  {
    title: "Return when you want to submit",
    description:
      "Turn on Press Return if the Mac field should submit after the text arrives, such as a terminal or a chat box.",
    icon: "bx:bxs-terminal",
  },
];
---

<div id="features" class="mt-24 scroll-mt-8">
  <h2 class="text-4xl lg:text-5xl font-bold lg:tracking-tight">
    Features
  </h2>
  <p class="text-lg mt-4 text-slate-600">
    Use the voice input on your iPhone to talk to any AI app on your Mac.
  </p>
</div>

<div class="grid sm:grid-cols-2 md:grid-cols-3 mt-16 gap-16">
  {
    features.map((item) => (
      <div class="flex gap-4 items-start">
        <div class="mt-1 bg-black rounded-full  p-2 w-8 h-8 shrink-0">
          <Icon class="text-white" name={item.icon} />
        </div>
        <div>
          <h3 class="font-semibold text-lg">{item.title}</h3>{" "}
          <p class="text-slate-500 mt-2 leading-relaxed">{item.description}</p>
        </div>
      </div>
    ))
  }
</div>
