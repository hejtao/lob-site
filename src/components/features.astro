---
// @ts-ignore
import { Icon } from "astro-icon/components";

const features = [
  {
    title: "Your iPhone is the microphone",
    description:
      "The iPhone you already have is the microphone. No need to buy another one for your Mac.",
    icon: "bx:bxs-microphone",
  },
  {
    title: "Keep the voice input you already use",
    description:
      "Dictate with the voice input already on your iPhone, including the built-in one. Lob only sends that text to your Mac.",
    icon: "bx:bxs-user-voice",
  },
  {
    title: "Typed at the Mac cursor",
    description:
      "Lob types into the field that's focused on your Mac, just like a keyboard. Stay in the AI app you already have open.",
    icon: "bx:bxs-keyboard",
  },
  {
    title: "No copy, AirDrop, or Notes",
    description:
      "The words go straight from your iPhone into the Mac field. Skip the copy, the AirDrop, and the stop in Notes.",
    icon: "bx:bxs-paste",
  },
  {
    title: "Connected over Bluetooth",
    description:
      "Once both apps are installed, your iPhone and Mac talk over Bluetooth. No cable to leave plugged in.",
    icon: "bx:bluetooth",
  },
  {
    title: "Press Return when you want to send",
    description:
      "Turn on Press Return if the field should submit after the text arrives, such as a terminal or a chat box.",
    icon: "bx:bxs-terminal",
  },
  {
    title: "Text Shortcuts",
    description:
      "A shortcut runs as soon as its trigger appears in the text. Add as many as you need.",
    icon: "bx:command",
    commands: [
      { name: "Newline", detail: "inserts a line break." },
      { name: "Clear", detail: "removes the trigger and everything before it." },
      { name: "Send", detail: "taps the Send button, which sends the message and clears the box." },
      { name: "Replace", detail: "swaps the trigger for the text you enter." },
    ],
  },
];
---

<div id="features" class="mt-24 scroll-mt-8">
  <h2 class="text-4xl lg:text-5xl font-bold lg:tracking-tight">
    Features
  </h2>
  <p class="text-lg mt-4 text-slate-600">
    Use the voice input on your iPhone to talk to any AI app on your Mac.
  </p>
</div>

<div class="grid sm:grid-cols-2 md:grid-cols-3 mt-16 gap-16">
  {
    features.map((item) => (
      <div class="flex gap-4 items-start">
        <div class="mt-1 bg-black rounded-full  p-2 w-8 h-8 shrink-0">
          <Icon class="text-white" name={item.icon} />
        </div>
        <div>
          <h3 class="font-semibold text-lg">{item.title}</h3>{" "}
          <p class="text-slate-500 mt-2 leading-relaxed">{item.description}</p>
          {
            item.commands && (
              <ul class="mt-2 list-disc space-y-1 pl-4 text-slate-500 leading-relaxed">
                {item.commands.map((command) => (
                  <li>
                    <span class="font-medium text-slate-700">{command.name}</span> {command.detail}
                  </li>
                ))}
              </ul>
            )
          }
        </div>
      </div>
    ))
  }
</div>
