---
import Container from "@/components/container.astro";
import Layout from "@/layouts/Layout.astro";
import { getLocale, useTranslations } from "@/i18n";

const t = useTranslations(getLocale(Astro.url.pathname));
---

<Layout title={t.privacy.title} description={t.privacy.description}>
  <Container>
    <article class="max-w-3xl pt-16 pb-24 md:pt-12">
      <h1 class="text-4xl font-bold lg:text-5xl lg:tracking-tight">{t.privacy.title}</h1>
      <p class="mt-4 text-sm text-slate-500">{t.privacy.updated}</p>
      <div class="mt-8 space-y-4 text-lg leading-relaxed text-slate-600">
        <p>{t.privacy.intro}</p>
      </div>

      {
        t.privacy.sections.map((section) => (
          <>
            <h2 class="mt-12 text-2xl font-semibold tracking-tight">{section.heading}</h2>
            {section.blocks.map((block) =>
              block.kind === "p" ? (
                <p class="mt-4 text-lg leading-relaxed text-slate-600">{block.text}</p>
              ) : (
                <ul class="mt-4 list-disc space-y-3 pl-5 text-lg leading-relaxed text-slate-600">
                  {block.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              ),
            )}
          </>
        ))
      }
    </article>
  </Container>
</Layout>
