---
import Container from "@/components/container.astro";
import LanguageSwitch from "@/components/language-switch.astro";
import Link from "@/components/ui/link.astro";
import { getLocale, localeHash, localePath, useTranslations } from "@/i18n";
import { Astronav, MenuItems, MenuIcon } from "astro-navbar";
import logoMark from "@/assets/icon.webp";

const locale = getLocale(Astro.url.pathname);
const t = useTranslations(locale);
const home = localePath(locale, "/");
const menuitems = [
  {
    title: t.nav.about,
    path: localeHash(locale, "about"),
  },
  {
    title: t.nav.features,
    path: localeHash(locale, "features"),
  },
];
---

<Container>
  <header class="flex flex-col lg:flex-row justify-between items-center my-5">
    <Astronav>
      <div class="flex w-full lg:w-auto items-center justify-between">
        <a href={home} class="flex items-center gap-2">
          <img
            src={logoMark.src}
            width={logoMark.width}
            height={logoMark.height}
            alt=""
            class="h-12 w-12 rounded-[22.37%] object-cover"
          />
          <span class="flex flex-col leading-tight">
            <span class="font-sans text-lg font-bold tracking-tight text-black">Lob</span>
            <span class="text-xs font-normal not-italic text-slate-500">{t.nav.tagline}</span>
          </span>
        </a>
        <div class="flex items-center gap-3 lg:hidden">
          <LanguageSwitch />
          <MenuIcon class="w-4 h-4 text-gray-800" />
        </div>
      </div>
      <MenuItems class="hidden w-full lg:w-auto mt-2 lg:flex lg:mt-0">
        <ul class="flex flex-col lg:flex-row lg:gap-3">
          {
            menuitems.map((item) => (
              <li>
                <a
                  href={item.path}
                  class="flex lg:px-3 py-2 items-center text-gray-600 hover:text-gray-900">
                  <span> {item.title}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <div class="lg:hidden flex items-center mt-3 gap-4">
          <Link
            href={localeHash(locale, "download")}
            size="md"
            block
            class="inline-flex items-center justify-center gap-1.5 rounded-lg!">
            {t.nav.download}
            <svg
              class="w-6 h-6"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true">
              <circle cx="12" cy="12" r="9"></circle>
              <path
                d="M12 7.5v6.5M8.5 12.5 12 16.5l3.5-4"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </Link>
        </div>
      </MenuItems>
    </Astronav>
    <div>
      <div class="hidden lg:flex items-center gap-4">
        <LanguageSwitch />
        <Link href={localeHash(locale, "download")} size="md" class="inline-flex items-center gap-1.5 rounded-lg!">
          {t.nav.download}
          <svg
            class="w-6 h-6"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true">
            <circle cx="12" cy="12" r="9"></circle>
            <path
              d="M12 7.5v6.5M8.5 12.5 12 16.5l3.5-4"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </Link>
      </div>
    </div>
  </header>
</Container>
