---
import { SEO } from "astro-seo";
import Navbar from "@/components/navbar/navbar.astro";
import favicon from "@/assets/icon.webp";
import "@fontsource-variable/inter/index.css";
import "@fontsource-variable/bricolage-grotesque";
import "../styles/global.css";

export interface Props {
  title: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.url.origin).toString();

const { title } = Astro.props;

const makeTitle = title
  ? title + " | " + "Lob"
  : "Lob — Speak on your iPhone. Talk to any AI app on your Mac.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/webp" href={favicon.src} />
    <meta name="generator" content={Astro.generator} />

    <SEO
      title={makeTitle}
      description="Use the voice input already on your iPhone. Lob types what you say into the AI app open on your Mac, right where the cursor is."
      canonical={canonicalURL}
    />
  </head>
  <body id="top">
    <Navbar />
    <slot />
    <style is:global>
      /* Improve Page speed */
      /* https://css-tricks.com/almanac/properties/c/content-visibility/ */
      img {
        content-visibility: auto;
      }
    </style>
  </body>
</html>
