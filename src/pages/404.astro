---
import Container from "@/components/container.astro";
import Layout from "@/layouts/Layout.astro";
import { getLocale, useTranslations } from "@/i18n";

const t = useTranslations(getLocale(Astro.url.pathname));
---

<Layout title={t.notFound.title}>
  <Container>
    <div class="min-h-[calc(100vh-16rem)] flex items-center justify-center">
      <div class="mt-16 text-center">
        <h1 class="text-4xl lg:text-5xl font-bold lg:tracking-tight">404</h1>
        <p class="text-lg mt-4 text-slate-600">{t.notFound.body}</p>
      </div>
    </div>
  </Container>
</Layout>
